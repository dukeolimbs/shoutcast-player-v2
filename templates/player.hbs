<form autocomplete="off">
  {{#if streamUrl}}

    <div class="stream-status {{state}}">
      {{#if isConnecting}}
        <i class="fas fa-spinner fa-spin"></i>
        <span>Connecting&hellip;</span>
      {{else if isPlaying}}
        <i class="fas fa-circle stream-live-dot"></i>
        <span>LIVE</span>
      {{else if isNoSignal}}
        <i class="fas fa-exclamation-triangle"></i>
        <span>No Signal &mdash; retrying&hellip;</span>
      {{else if isError}}
        <i class="fas fa-times-circle"></i>
        <span>Connection Failed</span>
      {{else}}
        <i class="fas fa-stop-circle"></i>
        <span>Stopped</span>
      {{/if}}
    </div>

    {{#if isNoSignal}}
      <p class="stream-info-msg">
        The stream is not broadcasting yet. Waiting for audio source&hellip;
      </p>
    {{/if}}

    {{#if isError}}
      <p class="stream-info-msg stream-error-msg">
        Cannot reach the stream server. Check that Icecast is running.
      </p>
    {{/if}}

    <div class="form-group buttons stream-buttons">
      {{#if isConnecting}}
        <button type="button" disabled>
          <i class="fas fa-spinner fa-spin"></i>
          Connecting&hellip;
        </button>
      {{else if isPlaying}}
        <button type="button" id="stop-stream">
          <i class="fas fa-stop"></i>
          Stop
        </button>
      {{else}}
        <button type="button" id="play-stream">
          <i class="fas fa-play"></i>
          Play
        </button>
        {{#if isNoSignal}}
          <button type="button" id="retry-stream">
            <i class="fas fa-redo"></i>
            Retry Now
          </button>
        {{/if}}
        {{#if isError}}
          <button type="button" id="retry-stream">
            <i class="fas fa-redo"></i>
            Retry
          </button>
        {{/if}}
      {{/if}}
    </div>

    <div class="form-group stream-volume">
      <label for="volume-control">Volume</label>
      <div class="form-fields">
        <input
          type="range"
          id="volume-control"
          min="0"
          max="100"
          value="{{currentVolume}}"
        />
        <span
          id="volume-display"
          class="stream-volume-value"
        >{{currentVolume}}%</span>
      </div>
    </div>

    <p class="notes">{{streamUrl}}</p>

  {{else}}
    <div class="notification warning">
      Audio Stream URL is not configured.
    </div>
    <p style="margin-top: 10px;">
      Go to
      <strong>Game Settings &rarr; SHOUTcast Player</strong>
      to set the stream URL.
    </p>
  {{/if}}
</form>